# Copiá este archivo a .env.local (o corré `npx neon env pull`, que lo genera).
NODE_ENV=development
PORT=3000
# Neon: usar la URL "pooled" (con -pooler en el host) para la app
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST/DB?sslmode=require
# Neon: URL directa (sin -pooler), la usa Prisma para las migraciones
DATABASE_URL_UNPOOLED=postgresql://USUARIO:PASSWORD@HOST/DB?sslmode=require
CORS_ORIGIN=http://localhost:5173
